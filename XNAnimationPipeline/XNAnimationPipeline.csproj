<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Libuv is pulled in transitively via MonoGame's SharpDX dependencies and reports
         legacy distro/version-specific RIDs that are never used on modern .NET. -->
    <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Content.Pipeline" Version="3.8.5">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\XNAnimation\XNAnimation.csproj">
      <Project>{1ef3e196-1367-4836-8041-43959bbae2c1}</Project>
      <Name>XNAnimation</Name>
    </ProjectReference>
  </ItemGroup>
</Project>
